{
  "name": "digital-human-video-agent",
  "version": "0.1.0",
  "description": "Turn a script into a digital-human video publishing pack",
  "type": "module",
  "license": "MIT",
  "bin": {
    "video-agent": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/scripts",
    "templates",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/cli.ts",
    "prepare": "npm run build",
    "smoke:live": "npm run build && node dist/scripts/live-smoke.js"
  },
  "keywords": [
    "fish-audio",
    "heygen",
    "hyperframes",
    "video-agent"
  ],
  "author": "xulei19771217",
  "dependencies": {
    "@types/node": "^26.1.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "open": "^11.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
